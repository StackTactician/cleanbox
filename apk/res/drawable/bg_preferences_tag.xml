<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/brand_gradient_start_20" android:endColor="@color/brand_gradient_end_20" android:angle="0.0" android:centerColor="@color/brand_gradient_center_20" />
            <corners android:radius="6.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white_10" />
            <corners android:radius="6.0dp" />
        </shape>
    </item>
</selector>
