<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/short_tv_main_gradient_start_20" android:endColor="@color/short_tv_main_gradient_end_20" android:angle="0.0" android:centerColor="@color/short_tv_main_gradient_center_20" />
            <corners android:radius="4.0dp" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/short_tv_white_10" />
            <corners android:radius="4.0dp" />
        </shape>
    </item>
</selector>
