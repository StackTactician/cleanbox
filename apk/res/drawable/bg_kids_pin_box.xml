<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/base_white_20_p" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="@color/base_white_30_p" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/base_white_20_p" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="@color/transparent" />
        </shape>
    </item>
</selector>
