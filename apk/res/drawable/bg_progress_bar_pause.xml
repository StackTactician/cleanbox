<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="2.0dp" />
            <solid android:color="@color/white_20" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:radius="2.0dp" />
                <solid android:color="@color/white_40" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:radius="2.0dp" />
                <gradient android:startColor="@color/brand_new_gradient_start" android:endColor="@color/brand_new_gradient_end" android:angle="0.0" android:centerColor="@color/brand_new_gradient_center" />
            </shape>
        </scale>
    </item>
</layer-list>
