<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="2.0dp" />
            <gradient android:startColor="#c8c8c8" android:endColor="#e6e6e6" android:angle="270.0" android:centerColor="#e3e3e3" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="2.0dp" />
                <gradient android:startColor="#3faff7" android:endColor="#3fa1ff" android:angle="0.0" android:centerColor="#3fa1f7" />
            </shape>
        </clip>
    </item>
</layer-list>
